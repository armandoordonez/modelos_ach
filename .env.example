# Copiar a .env y ajustar. El archivo .env NO se versiona.
#
#   cp .env.example .env

# =============================================================================
# Datos de entrada
# =============================================================================
# Carpeta local con los 3 XLSX que entrega ACH. La usa `make seed`.
# Se esperan exactamente estos nombres:
#   Conversion Seguridad Social 1 - Ofuscado.xlsx
#   Conversion Transferencias ACH 1 - Ofuscado.xlsx
#   Conversion Pagos Digitales 1 - Ofuscado.xlsx
ACH_DATA_DIR=/ruta/a/los/xlsx

# =============================================================================
# Almacenamiento S3 (MinIO en local, AWS en la nube: solo cambia el endpoint)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

ACH_BUCKET_RAW=raw
ACH_BUCKET_CURATED=curated
ACH_BUCKET_RESULTS=results

# =============================================================================
# Pipeline
# =============================================================================
# Llave de persona. 'cedula-v1' es la de producción: cruza las tres fuentes por la
# cédula ofuscada. 'legacy' reproduce las llaves compuestas de los scripts originales
# y existe solo para verificar la paridad de la migración.
ACH_LINEAGE=cedula-v1

# Ventana común a las tres fuentes. Un modelo puede acotarla desde models_config.yml.
ACH_WINDOW_START=2025-01
ACH_WINDOW_END=2026-06

ACH_SEED=42
ACH_LOG_LEVEL=INFO

# =============================================================================
# Airflow
# =============================================================================
AIRFLOW_VERSION=3.0.3
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin

# Genera claves propias antes de exponer esto fuera de tu máquina:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=cambia-esta-clave-en-produccion
AIRFLOW_JWT_SECRET=cambia-esta-clave-en-produccion

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Cuántos modelos corren a la vez. Con 8 GB de RAM en Docker, 2 es el máximo sensato:
# cada job carga en memoria las tablas persona-mes de las tres fuentes.
ACH_POOL_MODELOS=modelos
ACH_POOL_SLOTS=2
AIRFLOW_PARALLELISM=4
AIRFLOW_MAX_ACTIVE_TASKS=4

# =============================================================================
# Docker
# =============================================================================
# Red del compose. Los contenedores que lanza el DAG se conectan a ella para poder
# resolver 'minio' por nombre de servicio.
ACH_DOCKER_NETWORK=ach_net
ACH_JOBS_IMAGE=ach-jobs:latest

# =============================================================================
# Backend y frontend (los implementa el equipo de aplicación)
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
ACH_CORS_ORIGINS=http://localhost:5173
ACH_CACHE_TTL=30
